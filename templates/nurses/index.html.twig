{% extends 'base.html.twig' %}

{% block title %}Nurses index{% endblock %}

{% block body %}
    <h1>Nurses index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Last_name</th>
                <th>National_ID</th>
                <th>License_number</th>
                <th>Speciality</th>
                <th>Shift</th>
                <th>Email</th>
                <th>Password</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for nurse in nurses %}
            <tr>
                <td>{{ nurse.id }}</td>
                <td>{{ nurse.name }}</td>
                <td>{{ nurse.lastName }}</td>
                <td>{{ nurse.nationalID }}</td>
                <td>{{ nurse.licenseNumber }}</td>
                <td>{{ nurse.speciality }}</td>
                <td>{{ nurse.shift }}</td>
                <td>{{ nurse.email }}</td>
                <td>{{ nurse.password }}</td>
                <td>
                    <a href="{{ path('app_nurses_show', {'id': nurse.id}) }}">show</a>
                    <a href="{{ path('app_nurses_edit', {'id': nurse.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="10">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_nurses_new') }}">Create new</a>
{% endblock %}
