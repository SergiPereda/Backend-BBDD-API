{% extends 'base.html.twig' %}

{% block title %}Nurses{% endblock %}

{% block body %}
    <h1>Nurses</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ nurse.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ nurse.name }}</td>
            </tr>
            <tr>
                <th>Last_name</th>
                <td>{{ nurse.lastName }}</td>
            </tr>
            <tr>
                <th>National_ID</th>
                <td>{{ nurse.nationalID }}</td>
            </tr>
            <tr>
                <th>License_number</th>
                <td>{{ nurse.licenseNumber }}</td>
            </tr>
            <tr>
                <th>Speciality</th>
                <td>{{ nurse.speciality }}</td>
            </tr>
            <tr>
                <th>Shift</th>
                <td>{{ nurse.shift }}</td>
            </tr>
            <tr>
                <th>Email</th>
                <td>{{ nurse.email }}</td>
            </tr>
            <tr>
                <th>Password</th>
                <td>{{ nurse.password }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_nurses_index') }}">back to list</a>

    <a href="{{ path('app_nurses_edit', {'id': nurse.id}) }}">edit</a>

    {{ include('nurses/_delete_form.html.twig') }}
{% endblock %}
